+      } : null
+      if (node.operator==='^' && zero(right.coefficient) && right.constant.kind==='number') {
+        if (right.constant.value===0) return {coefficient:number(0),constant:number(1)}
+        if (right.constant.value===1) return left
+        if (zero(left.coefficient)) return {coefficient:number(0),constant:node}
+      }
+      return null
+    }
+    if (node.kind==='call') {
+      const args=node.args.map(child=>asLinear(child,depth+1))
+      return args.every(child=>child&&zero(child.coefficient)) ? {coefficient:number(0),constant:node} : null
+    }
+    return null
+  }
+  const linear=asLinear(expression)
+
+  return (from:Record<string,number>,to:Record<string,number>):boolean => {
+    const active=new Set<string>()
+    const interval=(node:Node,depth=0):Interval => {
+      if (depth>256) return null
+      const finite=(values:number[]):Interval => values.every(Number.isFinite) ? [Math.min(...values),Math.max(...values)] : null
+      if (node.kind==='number') return finite([node.value])
+      if (node.kind==='name') {
+        if (node.name===variable) return null
+        if (Object.hasOwn(from,node.name)&&Object.hasOwn(to,node.name)) return finite([from[node.name],to[node.name]])
+        if (node.name==='pi') return [Math.PI,Math.PI]
+        if (node.name==='e') return [Math.E,Math.E]
+        const helper=helpers.get(node.name)
+        if (!helper||active.has(node.name)) return null
+        active.add(node.name)
+        const result=interval(helper,depth+1)
+        active.delete(node.name)
+        return result
+      }
+      if (node.kind==='unary') {
+        const child=interval(node.child,depth+1)
+        return child && (node.sign==='+' ? child : [-child[1],-child[0]])
+      }
+      const power=(base:[number,number],exponent:[number,number]):Interval => {
+        const n=exponent[0]
+        if (n!==exponent[1]||!Number.isInteger(n)||Math.abs(n)>12) return null
+        if (n<0 && containsZero(base)) return null
+        const values=[base[0]**n,base[1]**n]
+        if (n>0 && n%2===0 && containsZero(base)) values.push(0)
+        return finite(values)
+      }
+      if (node.kind==='call') {
+        if (node.name!=='pow') return null
+        const base=interval(node.args[0],depth+1), exponent=interval(node.args[1],depth+1)
+        return base&&exponent ? power(base,exponent) : null
+      }
+      const left=interval(node.left,depth+1),right=interval(node.right,depth+1)
+      if (!left||!right) return null
+      if (node.operator==='+') return finite([left[0]+right[0],left[1]+right[1]])
+      if (node.operator==='-') return finite([left[0]-right[1],left[1]-right[0]])
+      if (node.operator==='*') return finite([left[0]*right[0],left[0]*right[1],left[1]*right[0],left[1]*right[1]])
+      if (node.operator==='/') return containsZero(right) ? null : finite([left[0]/right[0],left[0]/right[1],left[1]/right[0],left[1]/right[1]])
+      if (node.operator==='^') return power(left,right)
+      return null
+    }
+    for (const denominator of denominators) {
+      const range=interval(denominator)
+      if (range&&containsZero(range)) return false
+    }
+    // Only a genuinely linear equation has the implicit pole -C/L. A
+    // higher-order leading coefficient may vanish with a finite root left.
+    if (linear) {
+      const coefficient=interval(linear.coefficient),constant=interval(linear.constant)
+      if (coefficient&&constant&&containsZero(coefficient)&&!containsZero(constant)) return false
+    }
+    return true
+  }
+}
